{
  "name": "github-folder-sync",
  "version": "2.0.1",
  "description": "Keep a local folder in sync with a GitHub repository.",
  "license": "ISC",
  "author": "David Marjanidze",
  "homepage": "https://github.com/davidmarjanidze/github-folder-sync#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidmarjanidze/github-folder-sync.git"
  },
  "bugs": {
    "url": "https://github.com/davidmarjanidze/github-folder-sync/issues"
  },
  "keywords": [
    "github",
    "git",
    "sync",
    "folder sync",
    "backup"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && npm run build:esm && npm run build:cjs && npm run build:types",
    "build:esm": "esbuild src/index.ts --bundle --platform=node --target=node18 --format=esm --outfile=dist/index.mjs",
    "build:cjs": "esbuild src/index.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/index.cjs",
    "build:types": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "npm-publish": "npm run lint && npm run build && npm publish"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^18.19.130",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.4",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1"
  }
}
